<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bms.player.beatoraja.launcher.ReplayAnalysisView">
   <children>
      <SplitPane dividerPositions="0.3" layoutX="10.0" layoutY="10.0" prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <ListView fx:id="replayList" layoutX="-12.0" layoutY="14.0" prefHeight="598.0" prefWidth="236.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
               </children>
            </AnchorPane>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                     <children>
                        <Label fx:id="songTitleLabel" style="-fx-font-size: 20; -fx-font-weight: bold;" text="Select a Replay" />
                        <HBox spacing="20.0">
                           <children>
                              <Label fx:id="scoreLabel" text="Score: ---" />
                              <Label fx:id="judgeLabel" text="PG/GR/GD/BD/PR: ---" />
                           </children>
                        </HBox>
                        <BarChart fx:id="hitErrorHistogram" title="Hit Error Distribution">
                          <xAxis>
                            <CategoryAxis label="Error (ms)" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="Count" side="LEFT" />
                          </yAxis>
                        </BarChart>
                        <LineChart fx:id="gaugeHistoryChart" title="Gauge History">
                          <xAxis>
                            <NumberAxis label="Time (%)" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="Gauge (%)" side="LEFT" />
                          </yAxis>
                        </LineChart>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </children>
</AnchorPane>
