<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="bms.player.beatoraja.launcher.CourseEditorView" spacing="10">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <Label text="Course Editor" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="Title:"/>
        <TextField fx:id="courseTitleField" HBox.hgrow="ALWAYS"/>
        <Button text="Save Course" onAction="#saveCourse"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS">
        <VBox spacing="5">
            <Label text="Available Songs"/>
            <TextField fx:id="searchField" promptText="Search..."/>
            <TableView fx:id="songTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                    <TableColumn fx:id="artistColumn" text="Artist" prefWidth="150"/>
                    <TableColumn fx:id="levelColumn" text="Level" prefWidth="50"/>
                </columns>
            </TableView>
            <Button text="Add to Course ->" maxWidth="Infinity" onAction="#addSong"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Course Stages"/>
            <ListView fx:id="courseList" VBox.vgrow="ALWAYS"/>
            <Button text="Remove Selected" maxWidth="Infinity" onAction="#removeSong"/>
        </VBox>
    </SplitPane>
</VBox>
