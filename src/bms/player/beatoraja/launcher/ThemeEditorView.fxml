<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.25, 0.75" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8.0.121" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bms.player.beatoraja.launcher.ThemeEditorView">
    <items>
        <!-- Left: Skin & Object Selection -->
        <VBox spacing="10.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <Label text="Select Skin:" />
            <ComboBox fx:id="skinSelector" prefWidth="200.0" />
            <Label text="Active Skin Objects:" />
            <ListView fx:id="activeObjectsList" VBox.vgrow="ALWAYS" />
        </VBox>

        <!-- Center: Live Preview Canvas (LibGDX Embedded) -->
        <VBox fx:id="previewCanvas" alignment="CENTER" style="-fx-background-color: #000000;">
            <Label text="Live Skin Preview" textFill="WHITE" />
            <!-- LWJGL3 Canvas will be mounted here dynamically -->
        </VBox>

        <!-- Right: Properties Editor -->
        <VBox spacing="15.0">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <Label text="Properties Editor" style="-fx-font-weight: bold; -fx-font-size: 14;" />
            <VBox spacing="5.0">
                <Label text="Destination X (dstX):" />
                <TextField fx:id="dstXField" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Destination Y (dstY):" />
                <TextField fx:id="dstYField" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Scale X:" />
                <TextField fx:id="scaleXField" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Scale Y:" />
                <TextField fx:id="scaleYField" />
            </VBox>
            
            <HBox spacing="10.0" alignment="BOTTOM_RIGHT">
                <VBox.margin><Insets top="20.0" /></VBox.margin>
                <Button text="Revert" />
                <Button text="Save Skin.json" onAction="#onSaveSkin" defaultButton="true"/>
            </HBox>
        </VBox>
    </items>
</SplitPane>
